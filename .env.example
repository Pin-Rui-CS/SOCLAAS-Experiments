# Copy to .env and fill in. This template is safe to commit; .env is gitignored.
# One file serves every project here — the Python tools walk up to find it, and
# the website loads it via web/next.config.ts.

# --- SoCLaaS gateway ---------------------------------------------------------
SOCLAAS_API_KEY=clsk_your_key_here
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1

# --- Website only ------------------------------------------------------------
# Shared password for the site. Generate a long random one:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
APP_PASSWORD=change_me

# Signs the session cookie:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change_me_to_something_long_and_random

# --- Web search for the chat project, OPTIONAL -------------------------------
# Set ONE. Unset means the Web toggle is hidden and chat behaves as before.
# TAVILY_API_KEY=tvly-...
# BRAVE_SEARCH_API_KEY=BSA...

# --- API Agent, both OPTIONAL ---------------------------------------------
# All twelve APIs the agent ships with are keyless. These two only add things.

# SEC asks callers to identify themselves and throttles those who don't. Set it
# to an address you're happy sending to sec.gov; unset just means a generic UA.
# SEC_EDGAR_CONTACT=you@example.com

# FRED unlocks economics: inflation, unemployment, GDP, rates, house prices.
# It also carries the release calendar and vintage fields the agent needs to
# answer "has this figure been published yet". Free, instant:
#   https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=...

# GitHub works without a key at 60 requests/hour. A token raises it to 5,000;
# the adapter stays available either way.
# GITHUB_TOKEN=...

# Metaculus closed public read access, so its adapter is hidden without a token.
# Get one from your Metaculus account settings.
# METACULUS_API_TOKEN=...
