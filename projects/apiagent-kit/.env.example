# apiagent-kit — configuration
#
# Copy to `.env` and fill in. Every value here is optional except the LLM
# credentials, and 22 of the 24 APIs need no credential at all.
#
# Node reads this file directly:  node --env-file-if-exists=.env examples/ask.ts


# --- Your LLM ---------------------------------------------------------------
# Only needed for `runAgent`. The toolkit and registry work without any of this.
# These two are read by the examples; the library itself takes them as arguments,
# so name them whatever you like in your own code.
#
# Works with any OpenAI-compatible endpoint. Some known-good base URLs:
#   OpenAI       https://api.openai.com/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Ollama       http://localhost:11434/v1
#   SoCLaaS      https://soclaas-api.comp.nus.edu.sg/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# The loop forces a tool call on its first two steps. Pick a model that can
# actually run a multi-step dispatcher — read the note at the top of
# src/agent/loop.ts before choosing a small one.


# --- Identify yourself to the APIs ------------------------------------------
# Sent as the User-Agent on every outbound call. CHANGE THESE — they currently
# name the project this was extracted from.
#
# Keep the shapes: `Name/version`, and a real https URL describing the crawler.
# This is not cosmetic. Akamai (which fronts FRED, among others) scores requests
# on User-Agent, and an uncategorised string from a datacenter IP gets tarpitted
# into 30-second timeouts rather than refused outright. See the measurement note
# in src/core/http.ts.
APIAGENT_UA_PRODUCT=YourProject/1.0
APIAGENT_UA_URL=https://your-project.example.com


# --- Per-API credentials ----------------------------------------------------
# All optional. An API with no key is treated as absent, not broken: it is
# filtered out of the shortlist so the model is never offered something that
# cannot work.

# FRED — US economic time series (St. Louis Fed).
# Without this the `fred` adapter switches itself off.
# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Metaculus — community forecasts (Tier B: an input, never a resolution source).
# Without this the `metaculus` adapter switches itself off.
METACULUS_API_TOKEN=

# GitHub — raises the API rate limit from 60/hour to 5000/hour.
# The `github` adapter works without it, just with less headroom.
# A classic token with no scopes is enough for public data.
GITHUB_TOKEN=

# SEC EDGAR — a contact email, appended to the User-Agent.
# The SEC asks filers of automated requests to identify themselves and throttles
# those that do not. This is a personal detail being sent to a third party, so
# it is opt-in rather than baked in.
SEC_EDGAR_CONTACT=
