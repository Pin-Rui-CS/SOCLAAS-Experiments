# Copy to web/.env.local for local development.
# On Vercel, set these four in Project Settings -> Environment Variables.
#
# Note: the Python projects read the shared .env at the REPO ROOT instead.
# This file is only for the website.

# From the SoCLaaS portal. Never commit the real value — this repo is public.
SOCLAAS_API_KEY=clsk_your_key_here
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1

# The shared password for the site. Generate a long random one; it is the only
# thing standing between the open internet and your API quota:
#   node -e "console.log(crypto.randomUUID())"
APP_PASSWORD=change_me

# Signs the session cookie. Any long random string. Changing it signs everyone
# out immediately, which is how you revoke access.
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=change_me_to_something_long_and_random
